# Go API
GO_API_PORT=8080
NODE_API_URL=http://localhost:3000
NODE_API_TIMEOUT_MS=5000

# Node API
NODE_API_PORT=3000

# JWT (shared secret between go-api and node-api)
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24
API_KEY=change-me-api-key

# Docker Compose overrides NODE_API_URL to http://node-api:3000 inside go-api
